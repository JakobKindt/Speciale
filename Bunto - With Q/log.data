\
set terminal svg ;\
set output "intensities.svg" ;\
set xrange[0:2*pi] ;\
set key outside right ;\
set format y "%.0t" ;\
set multiplot layout 4,1 ;\
set ylabel "Intensity spectrum" ;\
set label "10^{-15}" at graph 0.01,1.05 ;\
set label "a) {/Symbol z} = 0" at graph 0.1,0.8 ;\
plot \
	"intensities.txt" using 1:2 index 0 with linespoints title "" ,\
	"intensities.txt" using 1:3 index 0 with linespoints title "" ,\
	"intensities.txt" using 1:4 index 0 with linespoints title "" ,\
	"intensities.txt" using 1:5 index 0 with linespoints title "" ;\
unset label ;\
set label "a) {/Symbol z} = r" at graph 0.1,0.8 ;\
plot \
	"intensities.txt" using 1:2 index 1 with linespoints title "" ,\
	"intensities.txt" using 1:3 index 1 with linespoints title "" ,\
	"intensities.txt" using 1:4 index 1 with linespoints title "" ,\
	"intensities.txt" using 1:5 index 1 with linespoints title "" ;\
unset label ;\
set label "a) {/Symbol z} = ir" at graph 0.1,0.8 ;\
plot \
	"intensities.txt" using 1:2 index 2 with linespoints title "" ,\
	"intensities.txt" using 1:3 index 2 with linespoints title "" ,\
	"intensities.txt" using 1:4 index 2 with linespoints title "" ,\
	"intensities.txt" using 1:5 index 2 with linespoints title "" ;\
unset label ;\
set label "a) {/Symbol z} = -r" at graph 0.1,0.8 ;\
plot \
	"intensities.txt" using 1:2 index 3 with linespoints title "E = 1.892 eV" ,\
	"intensities.txt" using 1:3 index 3 with linespoints title "E = 8.088 eV" ,\
	"intensities.txt" using 1:4 index 3 with linespoints title "E = 14.29 eV" ,\
	"intensities.txt" using 1:5 index 3 with linespoints title "E = 20.48 eV" ;\
unset multiplot
